PORT=4000
# URL(s) del frontend separadas por comas. En producción: https://tu-app.vercel.app
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/butaca
MONGODB_DB=butaca
# En producción (MongoDB Atlas): mongodb+srv://usuario:password@cluster.mongodb.net/butaca
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# TMDB: usa el "API Read Access Token" (recomendado) o, si no, la "API Key" corta
TMDB_READ_TOKEN=tu_api_read_access_token
TMDB_API_KEY=
# Gemini: clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Correos de confirmación con Brevo (https://www.brevo.com, plan gratis 300 correos/día).
# Sin BREVO_API_KEY los correos no se envían: el enlace de confirmación se muestra en la consola.
BREVO_API_KEY=
EMAIL_FROM=tu-email-verificado-en-brevo@ejemplo.com
EMAIL_FROM_NAME=Butaca
